{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.agents/hooks/guard-codex-git-push.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.agents/hooks/drift-check.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
